# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_or_test_xxx

# Signing key for post-payment form unlock tokens (any long random string)
PAYMENT_TOKEN_SECRET=change-me-to-a-long-random-string
PAYMENT_TOKEN_TTL_HOURS=48

# Email via Resend (https://resend.com) - works on Vercel
RESEND_API_KEY=re_xxx
RECIPIENT_EMAIL=fjosebis@gmail.com
# Must be a verified domain sender in Resend (or use onboarding@resend.dev for tests)
FROM_EMAIL=JOSEBIS GLOBAL VENTURES LLC <noreply@josebisglobalventures.com>

# Public site URL used in the form-link email after payment (no trailing slash)
SITE_URL=https://your-domain.vercel.app

# Local / staging only - unlock form without Stripe
ALLOW_TEST_PAYMENT=false
# Optional: where to send the form-link email during test payments
# TEST_CUSTOMER_EMAIL=you@example.com
